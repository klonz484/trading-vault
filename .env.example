# Create a free GroqCloud account and generate an API key:
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default vision model
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Public Supabase client configuration only.
# Copy this file to .env.local and fill in Development project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
