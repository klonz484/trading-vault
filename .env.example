# Groq Vision AI (server-side only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Required for the owner-only workspace gate. Use the permanent owner's Supabase Auth user UUID.
# Never use an email address or user-editable metadata as an authorization identifier.
TRADING_VAULT_OWNER_USER_ID=your_owner_user_uuid_here

# Optional market-data provider keys. Verify provider entitlements/licensing before activation.
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Optional: approved freshness limits by instrument and timeframe, in seconds.
# Keep {} until each pair/timeframe has been calibrated; a global limit is not accepted.
TRADING_VAULT_MARKET_DATA_FRESHNESS_POLICY_JSON={}
